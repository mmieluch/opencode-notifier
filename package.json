{
  "name": "@mohak34/opencode-notifier",
  "version": "0.2.9-beta.0",
  "description": "OpenCode plugin that sends system notifications and plays sounds when permission is needed, generation completes, or errors occur",
  "author": "mohak34",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mohak34/opencode-notifier.git"
  },
  "homepage": "https://github.com/mohak34/opencode-notifier#readme",
  "bugs": {
    "url": "https://github.com/mohak34/opencode-notifier/issues"
  },
  "files": [
    "dist",
    "src",
    "!src/*.test.ts",
    "sounds",
    "logos"
  ],
  "keywords": [
    "opencode",
    "opencode-plugin",
    "notifications",
    "sound",
    "alerts"
  ],
  "dependencies": {
    "@opencode/plugin": "^2.0.3",
    "is-wsl": "^3.1.0",
    "node-notifier": "^10.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.3",
    "@types/node-notifier": "^8.0.5",
    "typescript": "5.9.3",
    "tsup": "^8.5.1",
    "vitest": "^5.0.1"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "bun": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./tui": {
      "types": "./dist/tui.d.ts",
      "bun": "./src/tui.ts",
      "import": "./dist/tui.js"
    }
  }
}
